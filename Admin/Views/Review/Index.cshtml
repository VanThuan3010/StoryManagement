@using StoryManagement.Model.Entity
@using StoryManagement.Model.Enum
@model Reviews
@{
    ViewData["Title"] = "Đánh giá & Review";
    Story story = (Story)ViewBag.getStory;
}
<div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
    <div class="breadcrumb-title pe-3">Truyện</div>
    <div class="ps-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 p-0">
                <li class="breadcrumb-item">
                    <a href="/"><i class="bx bx-home-alt"></i></a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">@story.Name</li>
            </ol>
        </nav>
    </div>
</div>
<input type="hidden" value="@Model.Id" id="saveReviewId" />
<div class="container">
    <form asp-action="CreateOrUpdate" enctype="multipart/form-data" id="form" method="post">
        <input type="hidden" id="IdStory" value="@Model.IdStory" />
        <div class="col">
            <label>Review</label>
            <div class="form-group">
                <div class="col-md-12">
                    <textarea class="form-control" id="txtReview" name="txtReview">@(Model?.Review != null ? Model.Review : null)</textarea>
                </div>
            </div>
        </div>
        <div class="col">
            <label>Giới thiệu</label>
            <div class="form-group">
                <div class="col-md-12">
                    <textarea class="form-control" id="txtOpening" name="txtOpening">@(Model?.Opening != null ? Model.Opening : null)</textarea>
                </div>
            </div>
        </div>
        <div class="mt-4">
            <button class="btn btn-success" style="width:100px;" type="button" id="btnSave">Lưu</button>
            <a href="/Story/index" class="btn w-md btn-outline-info waves-effect waves-light">Quay lại</a>
        </div>
    </form>
</div>
@section Scripts {
    <script type="text/javascript">
        CKEDITOR.replace('txtReview', {
            extraPlugins: 'uploadimage,image2',
            uploadUrl: '/Review/UploadImage',
            pasteFromWordRemoveFontStyles: true,
            pasteFromWordRemoveStyles: true
        });
        CKEDITOR.replace('txtOpening', {
            extraPlugins: 'uploadimage,image2',
            uploadUrl: '/Review/UploadImage',
            pasteFromWordRemoveFontStyles: true,
            pasteFromWordRemoveStyles: true
        });
    </script>
}