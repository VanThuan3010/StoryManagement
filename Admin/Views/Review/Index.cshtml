@using StoryManagement.Model.Entity
@using StoryManagement.Model.Enum
@model Reviews
@{
    ViewData["Title"] = "Đánh giá & Review";
    Story story = (Story)ViewBag.getStory;
}
<div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
    <div class="breadcrumb-title pe-3">Truyện</div>
    <div class="ps-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 p-0">
                <li class="breadcrumb-item">
                    <a href="/"><i class="bx bx-home-alt"></i></a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">@story.Name</li>
            </ol>
        </nav>
    </div>
</div>
<div class="container">
    <form asp-action="CreateOrUpdate" enctype="multipart/form-data" id="form" method="post">
        <input asp-for="@Model.IdStory" hidden />
        <div class="col">
            <label>Review</label>
            <div class="form-group">
                <div class="col-md-12">
                    @Html.TextAreaFor(m => m.Review, new { @class = "form-control", id = "txtReview" })
                </div>
            </div>
        </div>
        <div class="col">
            <label>Giới thiệu</label>
            <div class="form-group">
                <div class="col-md-12">
                    @Html.TextAreaFor(m => m.Opening, new { @class = "form-control", id = "txtOpening" })
                </div>
            </div>
        </div>
        <div class="mt-4">
            <button class="btn btn-success" style="width:100px;" type="submit" id="Save">Lưu</button>
            <a href="/Story/index" class="btn w-md btn-outline-info waves-effect waves-light">Quay lại</a>
        </div>
    </form>
</div>
@section Scripts {
    <script type="text/javascript">
        CKEDITOR.replace('txtReview');
        CKEDITOR.replace('txtOpening');
    </script>
}