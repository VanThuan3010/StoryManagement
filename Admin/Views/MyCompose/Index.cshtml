<div class="workspace">
    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="sidebar-head">
            <span>Cấu trúc</span>
            <button class="btn-add-root" onclick="myCompose.addNode(null)">＋ Thêm gốc</button>
        </div>
        <div class="tree-scroll" id="treeRoot"></div>
    </aside>

    <!-- CONTENT -->
    <main class="content">
        <div id="contentPanel">
            <div class="content-body">
                <div class="empty-state">
                    <div class="icon">🌿</div>
                    <p>Chọn một node để xem chi tiết</p>
                </div>
            </div>
        </div>
    </main>
</div>

<div class="toast-wrap" id="toastWrap"></div>
