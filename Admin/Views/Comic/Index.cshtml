@using Newtonsoft.Json
@using StoryManagement.Model.Entity
@using StoryManagement.Model.Enum

@{
    ViewData["Title"] = "Truyện tranh";
}
<div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
    <div class="breadcrumb-title pe-3">Truyện Tranh</div>
    <div class="ps-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 p-0">
                <li class="breadcrumb-item">
                    <a href="/"><i class="bx bx-home-alt"></i></a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Danh sách truyện Tranh</li>
            </ol>
        </nav>
    </div>
    <div class="ms-auto">
        <div class="btn-group">
            <button type="button" class="btn btn-primary" id="btnCreate">Thêm mới</button>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <div class="col-lg-3 mb-3">
                    <input type="text" class="form-control" id="txtSearch" placeholder="Từ khóa tìm kiếm" />
                </div>
                <div class="col-lg-1">
                    <button type="button" id="btnSearch" class="btn btn-primary btn-xs mr-5"><i class="fas fa-search"></i></button>
                </div>
                <div class="col-lg-12 table-responsive">
                    <table class="table table-bordered" id="tblComic"></table>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalCreateOrEdit" tabindex="-1" aria-labelledby="exampleModalLabel" aria-modal="true" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <input type="hidden" name="name" value="" id="txtIdComic" />
            <div class="modal-header">
                <h5 class="modal-title" id="labelAction"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="form-group mb-3">
                <input type="hidden" name="name" value="" id="txtIdStory" />
                <label class="form-label">Nguồn truyện chữ</label>
                <select class="form-select" id="sources" name="sources">
                </select>
            </div>
            <div class="modal-body">
                <input type="text" hidden id="txtIdModal" name="Id" />
                <div class="form-group mb-3">
                    <label class="form-label required">Tên</label>
                    <textarea rows="3" class="form-control" name="txtName" id="txtName"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="btnSubmit">Lưu</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>
