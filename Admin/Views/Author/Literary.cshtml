@using Newtonsoft.Json
@using StoryManagement.Model.Entity

@{
    ViewData["Title"] = "Tác phẩm";
    List<Story> stories = (List<Story>)ViewBag.ListLiterary;
    Authors author = (Authors)ViewBag.Author;
    var lstPseu = new List<string>();
    try
    {
        lstPseu = JsonConvert.DeserializeObject<List<string>>(author.Pseudonym);
    }
    catch
    {
        lstPseu = new List<string> { author.Pseudonym };
    }
}
<input type="hidden" name="authorId" id="authorId" value="@author.Id" />
<h3 class="mb-3 mt-3">Bút danh</h3>
<ul id="authorPseus">
    @if (lstPseu != null && lstPseu.Count > 0)
    {
        foreach (string pseu in lstPseu)
        {
            <li><a href="#" class="pseu">@pseu<i></i></a></li>        
        }        
    }
</ul>
<h3 class="mb-3 mt-3">Phong cách viết</h3>
<p>
    @author.Style
</p>
<hr />
<div class="row">
    <select class="form-select col-8" id="slStoryForAuthor">
    </select>
    <div class="col-1 mt-2"><button class="btn btn-success btnSaveStory">Lưu truyện</button></div>
</div>
<div class="row">
    <div class="col-4">
        <h4 class="mb-3 mt-3">Tác phẩm</h4>
        <div class="row" id="divLstStory">
            @if (stories != null && stories.Count > 0)
            {
                foreach (Story st in stories)
                {
                    var stNames = "";
                    try
                    {
                        var lstName = JsonConvert.DeserializeObject<List<string>>(st.Name);
                        stNames = lstName != null && lstName.Count > 0 ? lstName[0] : st.Name;
                    }
                    catch
                    {
                        stNames = st.Name;
                    }
                    
                    <div class="card col-3">
                        <div class="bg-image hover-overlay" data-mdb-ripple-init data-mdb-ripple-color="light">
                            <img src="https://bookcover.yuewen.com/qdbimg/349573/1040874138/300" class="img-fluid" title="@stNames" />
                            <a href="#!">
                                <div class="mask" style="background-color: rgba(251, 251, 251, 0.15);"></div>
                            </a>
                        </div>
                        <div class="card-body" style="padding: 0.25rem;">
                            <h6 class="card-title">@stNames</h6><br />
                            <div class="d-flex gap-2 ps-1">
                                <button class="btn btn-xs btn-primary btnReviewStory" data-id="@st.Id">Review</button>
                                <button class="btn btn-xs btn-danger btnDeleteStory">Xóa</button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
    <div class="col-8 border border-start-1" id="reviewDetail">
        <h4 class="mb-3 mt-3">Truyện</h4>
        <hr />
        <ul id="listStoryNames">
        </ul>
        <h4 class="mb-3 mt-3">Review</h4>
        <hr />
        <div id="divReview"></div>
    </div>
</div>